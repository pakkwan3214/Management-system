# -----------------------------------------------------------------------------
# Dealership Management System - Environment Variables (EXAMPLE)
# -----------------------------------------------------------------------------
# Copy this file to ".env" and fill in real values for your local machine.
# NEVER commit the real ".env" file. It is already excluded via .gitignore.
# -----------------------------------------------------------------------------

# --- Database -----------------------------------------------------------------
# Connection string for the PostgreSQL database used by Prisma.
# Local example if running Postgres via Docker or Postgres.app:
# postgresql://USER:PASSWORD@localhost:5432/dealership_dev
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dealership_dev"

# --- Application ----------------------------------------------------------------
# Public base URL of the app in this environment.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Authentication (placeholder for a future Foundation task) -----------------
# A long, random secret used to sign session/auth tokens once authentication
# is implemented. Generate one locally with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-generated-random-secret"

# --- Future external integrations (placeholders only) --------------------------
# Real values will be added when a specific integration module is built.
# EXAMPLE_INTEGRATION_API_KEY=""
